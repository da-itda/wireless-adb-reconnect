<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8: Windows 10/11에 기본 포함 → 런타임 설치 없이 exe 하나로 x64·ARM64 모두 실행
       화면(설치 마법사·페어링)은 WPF, 트레이는 WinForms NotifyIcon -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WirelessADBReconnect</AssemblyName>
    <RootNamespace>WirelessAdbReconnect</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Product>Wireless ADB Reconnect</Product>
    <AssemblyTitle>Wireless ADB Reconnect</AssemblyTitle>
    <Description>Wireless ADB Reconnect</Description>
    <Version>1.3.1</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- QR 생성. exe 하나로 배포하려고 DLL은 리소스로 넣고 실행 중에 불러온다 (Program.ResolveEmbedded) -->
    <PackageReference Include="QRCoder" Version="1.6.0" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <!-- 트레이 상태 아이콘 (assets/make_icons.sh) -->
    <EmbeddedResource Include="tray-ok-light.ico" LogicalName="tray-ok-light.ico" />
    <EmbeddedResource Include="tray-ok-dark.ico" LogicalName="tray-ok-dark.ico" />
    <EmbeddedResource Include="tray-fail-light.ico" LogicalName="tray-fail-light.ico" />
    <EmbeddedResource Include="tray-fail-dark.ico" LogicalName="tray-fail-dark.ico" />
    <!-- 일본어·중국어 문구 (영어 문구가 키, Lang.L) -->
    <EmbeddedResource Include="..\..\assets\i18n\ja.strings" LogicalName="i18n.ja.strings" />
    <EmbeddedResource Include="..\..\assets\i18n\zh-Hans.strings" LogicalName="i18n.zh-Hans.strings" />
    <EmbeddedResource Include="..\..\assets\i18n\zh-Hant.strings" LogicalName="i18n.zh-Hant.strings" />
    <EmbeddedResource Include="$(PkgQRCoder)\lib\net40\QRCoder.dll" LogicalName="deps.QRCoder.dll" />
    <Resource Include="app.ico" />
  </ItemGroup>
</Project>
