<!-- 페어링 영역: QR + 3단계 안내 + 상태 (+ 페어링 코드 입력). 설치 마법사와 페어링 창이 함께 쓴다 -->
<UserControl x:Class="WirelessAdbReconnect.PairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="12" VerticalAlignment="Top">
                <Border.Effect><DropShadowEffect Color="#0F2233" Opacity="0.08" BlurRadius="18" ShadowDepth="4" Direction="270"/></Border.Effect>
                <Image x:Name="Qr" Width="188" Height="188" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
            <StackPanel Margin="24,0,0,0" Width="228">
                <DockPanel Margin="0,0,0,14">
                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Mint2}" VerticalAlignment="Top" Margin="0,0,10,0">
                        <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step1" FontSize="13" TextWrapping="Wrap" LineHeight="20">휴대폰과 이 PC를 <Bold>같은 Wi‑Fi</Bold>에 연결</TextBlock>
                </DockPanel>
                <DockPanel Margin="0,0,0,14">
                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Mint2}" VerticalAlignment="Top" Margin="0,0,10,0">
                        <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock FontSize="13" Text="휴대폰에서 무선 디버깅 열기"/>
                        <Border Background="{StaticResource Soft}" CornerRadius="6" Padding="8,4" Margin="0,6,0,0" HorizontalAlignment="Left">
                            <TextBlock FontSize="12" Foreground="{StaticResource Ink2}" Text="설정 › 개발자 옵션 › 무선 디버깅"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Mint2}" VerticalAlignment="Top" Margin="0,0,10,0">
                        <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="20"><Bold>QR 코드로 기기 페어링</Bold>을 눌러 왼쪽 QR 찍기</TextBlock>
                </DockPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="CodeRow" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="IP 주소:포트" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="Addr" Width="160" Style="{StaticResource Field}"/>
            <TextBlock Text="코드" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox x:Name="Code" Width="90" Style="{StaticResource Field}"/>
            <Button x:Name="CodeBtn" Content="페어링" Style="{StaticResource OutlineButton}" Height="32" Margin="10,0,0,0" Click="OnCodePair"/>
        </StackPanel>

        <Border x:Name="StatusBox" Background="{StaticResource Mint}" CornerRadius="10" Padding="14,12" Margin="0,18,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse x:Name="Pulse" Width="10" Height="10" Stroke="{StaticResource Brand}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale"/></Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX" From="1" To="2.4" Duration="0:0:1.6"/>
                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY" From="1" To="2.4" Duration="0:0:1.6"/>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:1.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource Brand}"/>
                </Grid>
                <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" Foreground="#0F5132" VerticalAlignment="Center" Text="adb 서버 준비 중…"/>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
