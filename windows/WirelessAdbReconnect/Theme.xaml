<!-- 공통 색·버튼·카드 (디자인 시안과 같은 값): https://claude.ai/artifact/AcexxtvRGVUCuaJBxK7k8q -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="UiFont">Malgun Gothic, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="Navy" Color="#0F2233"/>
    <SolidColorBrush x:Key="Navy2" Color="#1B3549"/>
    <SolidColorBrush x:Key="NavyDone" Color="#2A4A5F"/>
    <SolidColorBrush x:Key="Brand" Color="#3DDC84"/>
    <SolidColorBrush x:Key="BrandHover" Color="#34C877"/>
    <SolidColorBrush x:Key="OnBrand" Color="#0B1F14"/>
    <SolidColorBrush x:Key="BrandText" Color="#0F7A45"/>
    <SolidColorBrush x:Key="Mint" Color="#F1FCF6"/>
    <SolidColorBrush x:Key="Mint2" Color="#E8F9F0"/>
    <SolidColorBrush x:Key="Ink" Color="#13202B"/>
    <SolidColorBrush x:Key="Ink2" Color="#33424F"/>
    <SolidColorBrush x:Key="Muted" Color="#5B6874"/>
    <SolidColorBrush x:Key="Line" Color="#E3E8ED"/>
    <SolidColorBrush x:Key="Line2" Color="#C9D2DA"/>
    <SolidColorBrush x:Key="Soft" Color="#F6F8FA"/>
    <SolidColorBrush x:Key="Side1" Color="#DCE6EE"/>
    <SolidColorBrush x:Key="Side2" Color="#9FB2C2"/>
    <SolidColorBrush x:Key="Side3" Color="#7F95A8"/>
    <SolidColorBrush x:Key="SideRing" Color="#4A6378"/>
    <SolidColorBrush x:Key="Danger" Color="#C93A3A"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FDF1F1"/>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="Desc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- 초록 주 버튼 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource OnBrand}"/>
        <Setter Property="Background" Value="{StaticResource Brand}"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource BrandHover}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 테두리 버튼 -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="White" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Soft}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 글자 버튼 -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="4,10">
                        <ContentPresenter x:Name="c" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Opacity" Value="0.7"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 선택 카드 (라디오) -->
    <Style x:Key="ChoiceCard" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="card" Background="White" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,3,14,0" VerticalAlignment="Top">
                                <Ellipse x:Name="ring" Stroke="{StaticResource Line2}" StrokeThickness="1.5"/>
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource BrandText}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{StaticResource Mint}"/>
                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brand}"/>
                            <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="card" Property="Padding" Value="17,15"/>
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource BrandText}"/>
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 스위치 (체크박스) -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="22" Background="Transparent">
                        <Border x:Name="track" CornerRadius="11" Background="{StaticResource Line2}"/>
                        <Ellipse x:Name="knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource BrandText}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
